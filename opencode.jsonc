{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plain": {
      "description": "Claude Opus 5.5 with pi system prompt",
      "model": "github-copilot/claude-opus-5.5",
      "system": "{file:./prompts/pi.txt}"
    }
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp",
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--browser", "chrome",
          "--caps", "devtools",
          "--codegen", "none",
          "--console-level", "info",
          "--ignore-https-errors",
          "--viewport-size", "1920x1080"
        ],
        "disabled": true
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.eu/v1/mcp",
        "disabled": true
      }
    }
  }
}
